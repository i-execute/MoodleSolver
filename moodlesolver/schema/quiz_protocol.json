{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "moodlesolver protocols",
  "quiz_actions": {
    "state": {"action": "state", "quiz_id": "int? — auto-resumes live attempt"},
    "radio": {"action": "select", "answers": [{"index": "0-based (reliable)", "label": "exact text (risky: nbsp)"}]},
    "checkbox": {"action": "select", "answers": [{"index": 0}, {"index": 3}]},
    "text": {"action": "text", "values": ["answer1", "answer2"]},
    "dropdowns": {"action": "selects", "pairs": [{"index": 0, "value": "opt text"}, {"index": 1, "value": "..."}]},
    "image_ocr": {"action": "ocr", "files": ["opt_image_0.b64"], "prompt": "Transcribe formula, symbols only."},
    "confirm": {"action": "confirm"},
    "resume": {"action": "resume", "quiz_id": 328704},
    "submit": {"action": "submit"}
  },
  "response_view": {
    "page": "int|null", "question": "text|null", "question_hash": "md5[:10]",
    "qtype": "radio|checkbox|select|text|unknown",
    "options": ["..."], "option_kinds": ["radio", "checkbox"],
    "checked": [false, true], "selects": [{"options": ["..."], "value": "..."}],
    "text_inputs": [""], "images": ["opt_image_0.b64"],
    "question_image": "q_image.b64", "buttons": ["next=...", "finishattempt=..."],
    "url": "..."
  },
  "error_codes": {
    "E_LOGIN": "login failed", "E_NO_TAB": "no live tab",
    "E_DEAD_TAB": "[object Object] 404 — call resume",
    "E_NO_ATTEMPT": "start_attempt first", "E_NO_SUMMARY": "submit failed",
    "E_NOTHING_CHECKED": "confirm before selecting",
    "E_NO_MATCH": "label mismatch — use index",
    "E_NO_INPUT": "text index out of range",
    "E_NO_OPTION": "select value absent", "E_NO_IMG": "canvas grab failed",
    "E_OCR": "vision failed", "E_QUIZ_CLOSED": "no attempts",
    "E_UNKNOWN_ACTION": "bad action"
  },
  "ctx_actions": {
    "get_courses": "[] {id, name}",
    "get_course": "{id, name, sections, quizzes, resources, quiz_ids, resource_ids}",
    "dump_course": "{file, quizzes, resources, downloaded}",
    "download_images": "{files, count}",
    "download_resource": "{file, bytes}",
    "search_courses": "filter by substring"
  },
  "human_interference": "compare question_hash between calls: changed without your confirm = human answered/skipped"
}
